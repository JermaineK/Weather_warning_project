###############################################
# WEATHER WARNING PROJECT — CLEAN .GITIGNORE
# Tailored for large grid-stage outputs,
# scoring pipelines, alert tables, models,
# and data_subprocess scripts.
###############################################

###############
## PYTHON ENV ##
###############
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
build/
dist/
pip-wheel-metadata/

######################
## OS / EDITOR JUNK ##
######################
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
~$*

#########################
## PROJECT DATA OUTPUT ##
#########################
# All heavy files generated by the pipeline
data/**/*.csv
data/**/*.csv.gz
data/**/*.parquet
data/**/*.pq
data/**/*.json
data/**/*.h5
data/**/*.grib
data/**/*.nc

# BUT allow track/reference files:
!data/tracks/
!data/tracks/*.csv

########################
## MODEL ARTIFACTS    ##
########################
models/**
!models/.gitkeep

########################
## ALERTS & RESULTS   ##
########################
results/**
!results/.gitkeep

########################
## FIGURES / PLOTS    ##
########################
figures/**
!figures/.gitkeep

########################
## LOGS / TEMP FILES  ##
########################
logs/**
*.log

########################
## CONFIG FILES       ##
########################
*.yaml
*.yml

########################
## IDE CONFIGS        ##
########################
.vscode/
.idea/