###############################################
# WEATHER WARNING PROJECT — CLEAN .GITIGNORE
# Tailored for large grid-stage outputs,
# scoring pipelines, alert tables, models,
# and data_subprocess scripts.
###############################################

###############
## PYTHON ENV ##
###############
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
build/
dist/
pip-wheel-metadata/

######################
## OS / EDITOR JUNK ##
######################
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
~$*

#########################
## PROJECT DATA OUTPUT ##
#########################
# All heavy files generated by the pipeline
data/**/*.csv
data/**/*.csv.gz
data/**/*.parquet
data/**/*.pq
data/**/*.json
data/**/*.h5
data/**/*.grib
data/**/*.nc

# BUT allow track/reference files:
!data/tracks/
!data/tracks/*.csv
# Explicitly ignore oversized IBTrACS CSV to avoid pushing >100MB
data/tracks/ibtracs.ALL.list.v04r01.csv

########################
## MODEL ARTIFACTS    ##
########################
models/**
!models/.gitkeep

########################
## ALERTS & RESULTS   ##
########################
results/**
!results/.gitkeep

########################
## FIGURES / PLOTS    ##
########################
figures/**
!figures/.gitkeep

########################
## LOGS / TEMP FILES  ##
########################
logs/**
*.log

########################
## IDE CONFIGS        ##
########################
.vscode/
.idea/

#########################
## RAW ERA5 / EXTERNAL ##
#########################
data_era5/**
data_raw/**
external_data/**

# Global big binary formats we don't want in Git at all
*.parquet
*.pq
*.pqt
*.nc
*.grib
*.h5
*.npz
*.npy

#########################
## AUTOFIX OUTPUTS     ##
#########################
*.autofix.yaml
*.autofix.yml
